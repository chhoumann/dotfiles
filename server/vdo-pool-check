#!/usr/bin/env bash
# XFS on /data sees the virtual size; only this check sees the real pool.
# Also warns on root: the small root LV fills from caches and package stores.
set -euo pipefail

pct=$(lvs --noheadings -o data_percent vg0/vdopool 2>/dev/null | tr -d ' ' | cut -d. -f1 || true)
if [ -n "${pct:-}" ] && [ "$pct" -ge 80 ]; then
    msg="VDO pool vg0/vdopool at ${pct}% physical capacity. Free space (docker prune, delete worktrees, then fstrim /data) or lvextend the pool."
    logger -p user.warning "$msg"
    wall "$msg" 2>/dev/null || true
fi

root_pct=$(df --output=pcent / | tail -1 | tr -dc 0-9)
if [ "${root_pct:-0}" -ge 80 ]; then
    msg="Root filesystem at ${root_pct}%. Find growth: sudo du -x -d2 -h / | sort -rh | head. Heavy dirs belong on /data (bind mounts in fstab)."
    logger -p user.warning "$msg"
    wall "$msg" 2>/dev/null || true
fi
